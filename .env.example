# Copy to .env (never commit .env). Everything is optional.

# Publora: drafts and scheduling (or use the Publora connector instead).
PUBLORA_API_KEY=
# Optional default channels, comma-separated Publora connection ids.
PUBLORA_PLATFORMS=

# Pixfaro: data cards for posts (or use the Pixfaro connector instead).
PIXFARO_KEY=

# Anthropic: only for the autopilot outside Claude (GitHub Actions).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Memory folder (absolute path), if not ./mortgage-memory in the working folder.
MORTGAGE_MEMORY_DIR=
